{
  // Cloudflare Workers deployment (not Pages) via the OpenNext adapter.
  // See NOTES.md for why Workers + external Postgres rather than Pages + D1.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gym-tracker",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  // Nightly rebuild of the derived DailyStat table, at 03:15 UTC. The Worker's
  // scheduled handler has to call /api/cron/daily-stats with the CRON_SECRET
  // bearer token — see NOTES.md.
  "triggers": {
    "crons": ["15 3 * * *"]
  }
  // Secrets are NOT set here. Push them with `wrangler secret put <NAME>`:
  //   DATABASE_URL, BETTER_AUTH_SECRET, BETTER_AUTH_URL, ALLOWED_EMAILS, CRON_SECRET
  // NEXT_PUBLIC_APP_URL is inlined at build time, so set it in the build env.
}
