# --- Database -----------------------------------------------------------
# Two connection strings, both from the same Neon project.
#
# DATABASE_URL is the POOLED one (its host contains "-pooler"). connection_limit=1
# is deliberate: each serverless instance keeps its own pool, so anything higher
# multiplies with concurrency.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/gymtracker"
# DIRECT_URL is the UNPOOLED one. `prisma migrate deploy` and the exercise
# import need it — PgBouncer in transaction mode can hold neither Prisma's
# advisory locks nor its long transactions. Locally the two are the same.
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/gymtracker"

# --- Auth ---------------------------------------------------------------
BETTER_AUTH_URL="http://localhost:3000"
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET="change-me"

# The only two email addresses that may ever create an account. Lowercase, and
# they must match the Google accounts you sign in with.
ALLOWED_EMAILS="you@example.com,bro@example.com"

# Google OAuth — the only way in. Google Cloud Console > Credentials >
# OAuth client ID > Web application. Authorised redirect URI must be exactly:
#   http://localhost:3000/api/auth/callback/google      (local)
#   https://<your-domain>/api/auth/callback/google      (production)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Shared secret for the nightly stats rebuild at /api/cron/daily-stats.
# Optional locally. On Vercel, setting it makes Vercel Cron send it as a bearer
# token automatically, which is what the route checks.
# CRON_SECRET="openssl rand -hex 32"

# --- App ----------------------------------------------------------------
# Inlined at BUILD time — changing it needs a redeploy, not a restart.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
