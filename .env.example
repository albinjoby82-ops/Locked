# --- Database -----------------------------------------------------------
# Local: docker compose up -d  (see docker-compose.yml)
# Production: a Neon/Supabase pooled connection string.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/gymtracker"

# --- Auth ---------------------------------------------------------------
BETTER_AUTH_URL="http://localhost:3000"
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET="change-me"

# The only two email addresses that may ever create an account.
ALLOWED_EMAILS="you@example.com,bro@example.com"

# Shared secret for the nightly stats rebuild at /api/cron/daily-stats.
# Optional locally; set it in production so the cron can authenticate.
# CRON_SECRET="openssl rand -hex 32"

# --- App ----------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
