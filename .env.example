# --- Database -----------------------------------------------------------
# Local: docker compose up -d  (see docker-compose.yml)
# Production: a Neon/Supabase pooled connection string.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/gymtracker"

# --- Auth ---------------------------------------------------------------
BETTER_AUTH_URL="http://localhost:3000"
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET="change-me"

# The only two email addresses that may ever create an account.
ALLOWED_EMAILS="you@example.com,bro@example.com"

# --- App ----------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
